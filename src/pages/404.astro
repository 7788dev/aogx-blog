---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../utils/links.js'
---

<BaseLayout title="页面不存在">
  <div class="container not-found">
    <p class="code">404</p>
    <p class="msg">页面被风吹走了，也许它从未存在过。</p>
    <a class="text-link" href={withBase('/')}>← 回到首页</a>
  </div>
</BaseLayout>
