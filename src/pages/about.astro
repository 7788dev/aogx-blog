---
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMark from '../components/LogoMark.astro'
import AppIcon from '../components/AppIcon.astro'
import { siteConfig } from '../config.js'
import { withBase } from '../utils/links.js'

// 头像支持两种写法：站内相对路径（走 withBase）或任意绝对 URL
const avatarSrc = siteConfig.avatar
  ? siteConfig.avatar.startsWith('http')
    ? siteConfig.avatar
    : withBase(siteConfig.avatar)
  : ''
---

<BaseLayout title="关于">
  <div class="container">
    <div class="about-head">
      {
        avatarSrc ? (
          <img
            class="avatar-img"
            src={avatarSrc}
            alt={`${siteConfig.author} 的头像`}
            width="72"
            height="72"
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        ) : (
          <LogoMark size={72} />
        )
      }
      <h1>关于 {siteConfig.name}</h1>
    </div>

    <div class="about-body">
      <p>你好，我是 {siteConfig.author}。我不是职业写作者，也不是某个领域的专家——只是一个喜欢深度思考的人。</p>
      <p>
        站名「{siteConfig.name}」取自「寒风刺骨，傲骨心」——环境越冷，骨头越硬。
        这里会放一些我想清楚了的、或还在想的东西：对事情的判断、踩过的坑、读书和经历留下的经验。
        与其说是写给别人看，不如说是逼自己把模糊的直觉变成能站得住的观点。
      </p>
      <p>
        如果某一篇恰好对你有用，那就是它额外赚到的。
      </p>
    </div>

    <div class="about-links">
      <a class="social-link" href={siteConfig.github} target="_blank" rel="noopener">
        <AppIcon name="github" size={15} />
        GitHub
      </a>
      <a class="social-link" href={`mailto:${siteConfig.email}`}>
        <AppIcon name="mail" size={15} />
        Email
      </a>
    </div>
  </div>
</BaseLayout>
