---
// 站点 Logo：寒夜墨色底 + 白色孤星，呼应「傲骨心 / Aogx」的冷峻气质
// favicon（public/favicon.svg）与此保持一致
const { size = 24 } = Astro.props
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="logo-ink" x1="0" y1="0" x2="0" y2="64" gradientUnits="userSpaceOnUse">
      <stop stop-color="#272e38"></stop>
      <stop offset="1" stop-color="#10151c"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="12" fill="url(#logo-ink)"></rect>
  <path
    d="M32 12c1.9 11 9.1 18.2 20 20-10.9 1.8-18.1 9-20 20-1.9-11-9.1-18.2-20-20 10.9-1.8 18.1-9 20-20Z"
    fill="#f2f5f7"></path>
  <circle cx="46" cy="18" r="2.6" fill="#f2f5f7" opacity="0.88"></circle>
</svg>
